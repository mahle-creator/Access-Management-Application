@model IEnumerable<Access_Management_Application.Models.AccessLog>

@{
ViewData["Title"] = "Access Monitoring";
}

<div class="container mt-4">

<div class="d-flex flex-column flex-md-row
            justify-content-between
            align-items-md-center
            mb-4">

    <div>

        <h1>Access Monitoring</h1>

        <p class="text-muted mb-0">
            View access attempts recorded by the access control system.
        </p>

    </div>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3 mt-md-0">
        Back to Dashboard
    </a>

</div>


<div class="card shadow-sm">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-bordered
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th>Log ID</th>

                        <th>User</th>

                        <th>Date</th>

                        <th>Time</th>

                        <th>Decision</th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var log in Model)
                    {
                        <tr>

                            <td>
                                @log.AccessLogId
                            </td>

                            <td>
                                @log.UserName
                            </td>

                            <td>
                                @log.Date.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @log.Time.ToString("HH:mm:ss")
                            </td>

                            <td>

                                @if (log.Decision == "Granted")
                                {
                                    <span class="badge bg-success">
                                        Granted
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Denied
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

</div>