@{
ViewData["Title"] = "Access Result";
}

<div class="container mt-4">

<div class="row justify-content-center">

    <div class="col-12 col-md-8 col-lg-6">

        @if (ViewBag.Decision == "Granted")
        {
            <div class="card shadow-sm border-success">

                <div class="card-body text-center p-4">

                    <h1 class="text-success mb-3">
                        ACCESS GRANTED
                    </h1>

                    <p class="lead">
                        The user has been successfully recognised.
                    </p>

                    <hr />

                    <div class="text-start">

                        <p>
                            <strong>Person:</strong>
                            @ViewBag.UserName
                        </p>

                        <p>
                            <strong>Face ID:</strong>
                            @ViewBag.FaceId
                        </p>

                        <p>
                            <strong>Decision:</strong>
                            <span class="badge bg-success">
                                Granted
                            </span>
                        </p>

                        <p>
                            <strong>Reason:</strong>
                            @ViewBag.Reason
                        </p>

                    </div>

                    <div class="alert alert-success mt-4">

                        <strong>Door Status</strong>

                        <br />

                        Door can be unlocked.

                    </div>

                </div>

            </div>
        }
        else
        {
            <div class="card shadow-sm border-danger">

                <div class="card-body text-center p-4">

                    <h1 class="text-danger mb-3">
                        ACCESS DENIED
                    </h1>

                    <p class="lead">
                        Access to the door has been denied.
                    </p>

                    <hr />

                    <div class="text-start">

                        <p>
                            <strong>Person:</strong>
                            @ViewBag.UserName
                        </p>

                        <p>
                            <strong>Face ID:</strong>
                            @ViewBag.FaceId
                        </p>

                        <p>
                            <strong>Decision:</strong>
                            <span class="badge bg-danger">
                                Denied
                            </span>
                        </p>

                        <p>
                            <strong>Reason:</strong>
                            @ViewBag.Reason
                        </p>

                    </div>

                    <div class="alert alert-danger mt-4">

                        <strong>Door Status</strong>

                        <br />

                        Door must remain locked.

                    </div>

                </div>

            </div>
        }


        <div class="d-grid gap-2 mt-4">

            <a asp-action="Index"
               class="btn btn-primary">
                Scan Another Face
            </a>

            <a asp-controller="AccessLog"
               asp-action="Index"
               class="btn btn-secondary">
                View Access Monitoring
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Dashboard
            </a>

        </div>

    </div>

</div>

</div>