@model IEnumerable<Access_Management_Application.Models.User>

@{
    ViewData["Title"] = "Registered Users";
}

<div class="container mt-4">

    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        mb-4">

        <div>
            <h1>Registered Users</h1>

            <p class="text-muted mb-0">
                View and manage users registered in the access control system.
            </p>
        </div>

        <a asp-action="Register"
           class="btn btn-primary mt-3 mt-md-0">
            Register User
        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>User ID</th>
                            <th>Name</th>
                            <th>Face ID</th>
                            <th>Facial Data</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var user in Model)
                        {
                            <tr>

                                <td>
                                    @user.UserId
                                </td>

                                <td>
                                    @user.Name
                                </td>

                                <td>
                                    @user.FaceId
                                </td>

                                <td>
                                    @user.FacialData
                                </td>

                                <td>

                                    @if (user.Status == "Active")
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="d-flex flex-column flex-md-row gap-2">

                                        <!-- EDIT -->
                                        <a asp-action="Edit"
                                           asp-route-id="@user.UserId"
                                           class="btn btn-sm btn-primary">
                                            Edit
                                        </a>

                                        <!-- DEACTIVATE - ONLY FOR ACTIVE USERS -->
                                        @if (user.Status == "Active")
                                        {
                                            <a asp-action="Deactivate"
                                               asp-route-id="@user.UserId"
                                               class="btn btn-sm btn-warning">
                                                Deactivate
                                            </a>
                                        }

                                        <!-- REMOVE -->
                                        <form asp-action="Remove"
                                              asp-route-id="@user.UserId"
                                              method="post"
                                              style="display:inline;">

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Are you sure you want to permanently remove this user?');">
                                                Remove
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <div class="mt-3">

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>

    </div>

</div>